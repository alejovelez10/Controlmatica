<%# Resultado de decidir desde el correo. Sirve para las DOS acciones: `@accion`
    dice cual se intento (:aprobado o :rechazado) y `@resuelto` si salio bien.
    Una vista por accion habria duplicado la rama de error, que es la que menos
    se mira y la que mas importa que este bien. %>
<% rechazo = @accion == :rechazado %>
<%# ESTA PAGINA DICE "aprobado", NO "aceptado", y la diferencia no es un
    descuido. El estado operativo se llama "Aceptado" en la tabla de Gastos,
    pero aqui el boton dice "Aprobar este gasto" y el correo que trajo a esta
    persona dice "pendiente de su aprobación": cambiarle el verbo a mitad del
    camino hace dudar de si se hizo lo que se pidio. El vocabulario de esta
    pagina es el de la accion, no el de la columna. %>
<% ya_estaba = @expense.rechazado? ? "rechazado" : "aprobado" %>
<div class="cm-page" style="max-width: 560px; margin: 40px auto; padding: 0 16px;">
  <div style="background: #fff; border: 1px solid var(--cm-border); border-radius: 12px; padding: 28px; text-align: center;">

    <% if @ya_estaba %>
      <div style="font-size: 34px; color: var(--cm-text-muted); margin-bottom: 10px;">
        <i class="fas fa-check-circle"></i>
      </div>
      <h1 style="font-family: 'Poppins', sans-serif; font-size: 20px; margin: 0 0 8px;">
        Este gasto ya estaba <%= ya_estaba %>
      </h1>
      <p class="cm-hint" style="margin: 0;">
        Alguien ya lo decidió antes. No se hizo ningún cambio.
      </p>

    <% elsif @resuelto %>
      <div style="font-size: 34px; color: <%= rechazo ? "var(--cm-danger, #dc3545)" : "var(--cm-success, #28a745)" %>; margin-bottom: 10px;">
        <i class="fas fa-<%= rechazo ? "times" : "check" %>-circle"></i>
      </div>
      <h1 style="font-family: 'Poppins', sans-serif; font-size: 20px; margin: 0 0 8px;">
        Gasto <%= rechazo ? "rechazado" : "aprobado" %>
      </h1>
      <p class="cm-hint" style="margin: 0;">
        <%= @expense.invoice_name %> ·
        <%= ExpenseBudgetService.money(@expense.invoice_total) %> ·
        <%= @expense.cost_center&.code %>
      </p>
      <p class="cm-hint" style="margin: 14px 0 0;">
        <% if rechazo %>
          No pasa a Contabilidad y no consume presupuesto. Le avisamos a
          <%= @expense.user_invoice&.names || "la persona que lo reportó" %>.
        <% else %>
          Ya puede pasar a Contabilidad. Puede cerrar esta página.
        <% end %>
      </p>

    <% else %>
      <%# La rama que no se puede omitir: el guardado devolvio false. Pasa si una
          validacion del modelo rechaza el gasto. Decirle "aprobado" a alguien
          cuyo gasto sigue en "Creado" es peor que no mandar nada. %>
      <div style="font-size: 34px; color: var(--cm-danger, #dc3545); margin-bottom: 10px;">
        <i class="fas fa-exclamation-circle"></i>
      </div>
      <h1 style="font-family: 'Poppins', sans-serif; font-size: 20px; margin: 0 0 8px;">
        No se pudo <%= rechazo ? "rechazar" : "aprobar" %>
      </h1>
      <p class="cm-hint" style="margin: 0;">
        <%= @expense.errors.full_messages.presence&.join(". ") || "El gasto no pudo actualizarse." %>
      </p>
      <p class="cm-hint" style="margin: 14px 0 0;">
        Entre a Controlmatica y hágalo desde la pantalla de Gastos.
      </p>
    <% end %>
  </div>
</div>
