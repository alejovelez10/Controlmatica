<%# Mismas reglas que pending_approval.html.erb: estilos EN LINEA y tablas para
    la maquetacion, porque Outlook y Gmail descartan buena parte de un <style>
    del <head> y `layouts/mailer.html.erb` es un <body> pelado. Nada de clases
    del design system: ese CSS no viaja al correo. %>
<div style="font-family: Arial, Helvetica, sans-serif; font-size: 14px; color: #212529; line-height: 1.5; max-width: 560px; padding: 8px;">
  <p>Hola <%= @responsable&.names %>,</p>

  <p>
    El gasto que registró en el centro de costos
    <strong><%= @cost_center&.code || "(sin centro)" %></strong> fue
    <% if @rechazado %>
      <strong style="color: #c82333;">rechazado</strong>.
    <% else %>
      <strong style="color: #1e7e34;">aprobado</strong>.
    <% end %>
  </p>

  <table cellpadding="0" cellspacing="0" border="0" style="width: 100%; max-width: 520px; border: 1px solid #e2e5ea; border-radius: 8px; margin: 18px 0;">
    <tr>
      <td style="padding: 16px 18px;">
        <div style="font-size: 16px; font-weight: bold; margin-bottom: 10px;">
          <%= @expense.invoice_name %>
        </div>
        <table cellpadding="0" cellspacing="0" border="0" style="font-size: 13px; color: #6c757d;">
          <tr>
            <td style="padding: 2px 12px 2px 0;">Valor</td>
            <td style="padding: 2px 0; color: #212529;">
              <strong><%= ExpenseBudgetService.money(@expense.invoice_total) %></strong>
              <%= @expense.currency unless @expense.currency == "COP" %>
            </td>
          </tr>
          <tr>
            <td style="padding: 2px 12px 2px 0;">Fecha</td>
            <td style="padding: 2px 0; color: #212529;"><%= @expense.invoice_date&.strftime("%d/%m/%Y") || "—" %></td>
          </tr>
          <tr>
            <td style="padding: 2px 12px 2px 0;">Factura</td>
            <td style="padding: 2px 0; color: #212529;"><%= @expense.invoice_number.presence || "—" %></td>
          </tr>
          <% if @decisor.present? %>
            <tr>
              <td style="padding: 2px 12px 2px 0;">Decidió</td>
              <td style="padding: 2px 0; color: #212529;"><%= @decisor.names %></td>
            </tr>
          <% end %>
        </table>
      </td>
    </tr>
  </table>

  <%# EL MOTIVO VA EN SU PROPIO BLOQUE Y DESTACADO: es lo unico que le dice a la
      persona que hacer a continuacion. Metido entre las filas de la tabla de
      arriba se lee como un dato mas de la factura. %>
  <% if @rechazado && @motivo_rechazo.present? %>
    <table cellpadding="0" cellspacing="0" border="0" style="width: 100%; max-width: 520px; background: #fdf2f3; border: 1px solid #f5c2c7; border-radius: 8px; margin: 0 0 18px;">
      <tr>
        <td style="padding: 14px 18px;">
          <div style="font-size: 13px; color: #6c757d; margin-bottom: 4px;">Motivo del rechazo</div>
          <div style="color: #212529;"><%= @motivo_rechazo %></div>
        </td>
      </tr>
    </table>
  <% end %>

  <% if @rechazado %>
    <p>
      Un gasto rechazado no pasa a Contabilidad y no consume presupuesto. Si cree
      que hay un error, corrija el gasto desde Controlmatica: al editarlo vuelve
      a quedar en <strong>Creado</strong> y se revisa de nuevo.
    </p>
  <% else %>
    <p>No tiene que hacer nada más: el gasto ya pasó a Contabilidad.</p>
  <% end %>

  <p style="margin: 22px 0 0;">
    <a href="<%= @url_lista %>" style="color: #0b5ed7;">Ver mis gastos</a>
  </p>
</div>
