# Export de Contabilidad — 18 columnas (paquete 06, tarea B9).
#
# Este archivo y app/views/report_expenses/download_file.xlsx.axlsx son COPIAS
# byte a byte salvo el nombre. No es casualidad: es lo que permite que un solo
# mapeo de `ReportExpense.import` lea los dos archivos y que un Excel bajado de
# cualquiera de las dos pantallas se pueda reimportar.
#
# `column_widths` lleva 18 valores para 18 columnas. La plantilla de gastos
# declaraba 11 anchos para 12 columnas; ese bug NO se replica.
#
# Las guardas `present?` sobre `user_invoice` no son defensivas por gusto:
# db/schema.rb no tiene ni un `add_foreign_key`, asi que una sola FK colgante
# convierte el export entero en un 500.
wb = xlsx_package.workbook

wb.add_worksheet(name: "Items") do |sheet|
  sheet.add_row ["ID", "Centro de costo", "Responsable", "Fecha de factura", "Nombre",
                 "NIT / CEDULA", "Descripcion", "Numero de factura", "Tipo", "Medio de pago",
                 "Estado operativo", "Estado presupuestal", "Motivo presupuestal", "Moneda",
                 "Valor extranjero", "TRM", "Valor del pago (COP)", "IVA (COP)"]

  @items.each do |task|
    sheet.add_row [
      task.id,
      task.cost_center.present? ? task.cost_center.code : "",
      task.user_invoice.present? ? task.user_invoice.names : "",
      task.invoice_date,
      task.invoice_name,
      task.identification,
      task.description,
      task.invoice_number,
      task.type_identification.present? ? task.type_identification.name : "",
      task.payment_type.present? ? task.payment_type.name : "",
      task.is_acepted ? "Aceptado" : "Creado",
      budget_status_label(task.budget_status),
      task.budget_reason,
      task.currency,
      task.foreign_value,
      task.exchange_rate,
      task.invoice_value,
      task.invoice_tax
    ]
  end

  sheet.column_widths 10, 20, 30, 20, 20, 20, 40, 20, 25, 25, 18, 20, 40, 10, 18, 15, 20, 20
end
