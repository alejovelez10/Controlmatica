# Export de Gastos — 19 columnas (paquete 06, tarea C1).
#
# Este archivo y app/views/accounting_expenses/download_file.xlsx.axlsx son
# COPIAS byte a byte salvo el nombre. No es casualidad: es lo que permite que un
# solo mapeo de `ReportExpense.import` lea los dos archivos y que un Excel
# bajado de cualquiera de las dos pantallas se pueda reimportar.
#
# CAMBIOS RESPECTO DE LA VERSION ANTERIOR (12 columnas):
#  - `ID` pasa a ser la primera columna. Es la referencia contable que pedia el
#    cliente y la llave con la que el import ACTUALIZA en vez de duplicar.
#  - `column_widths` pasa de 11 valores a 18. Declaraba 11 para 12 columnas.
#  - `task.user_invoice.names` va con guarda: db/schema.rb no tiene ni un
#    `add_foreign_key`, asi que una FK colgante tumbaba el export completo con
#    NoMethodError.
#
# OBSERVACIONES VA EN LA POSICION 19, LA ULTIMA, Y ESO NO ES ESTETICA (2026-10-06):
# `ReportExpense.import` mapea las columnas POR POSICION contra V2_HEADER_KEYS, y
# un archivo con una columna de mas simplemente deja esa clave sin mapear y la
# ignora. Insertarla en medio, en cambio, correria todas las siguientes y el
# import leeria el numero de factura como si fuera el tipo de gasto, sin error.
#
# El import NO la lee de vuelta, tambien a proposito: agregarla a V2_HEADER_KEYS
# dejaria 19 claves contra los 18 encabezados de los archivos que la gente ya
# tiene guardados, y `Hash[[header, fila].transpose]` revienta cuando las dos
# listas no miden lo mismo —se perderia el archivo entero, no una columna—.
wb = xlsx_package.workbook

wb.add_worksheet(name: "Items") do |sheet|
  sheet.add_row ["ID", "Centro de costo", "Responsable", "Fecha de factura", "Nombre",
                 "NIT / CEDULA", "Descripcion", "Numero de factura", "Tipo", "Medio de pago",
                 "Estado operativo", "Estado presupuestal", "Motivo presupuestal", "Moneda",
                 "Valor extranjero", "TRM", "Valor del pago (COP)", "IVA (COP)",
                 "Observaciones"]

  @items.each do |task|
    sheet.add_row [
      task.id,
      task.cost_center.present? ? task.cost_center.code : "",
      task.user_invoice.present? ? task.user_invoice.names : "",
      task.invoice_date,
      task.invoice_name,
      task.identification,
      task.description,
      task.invoice_number,
      task.type_identification.present? ? task.type_identification.name : "",
      task.payment_type.present? ? task.payment_type.name : "",
      task.operational_state_label,
      budget_status_label(task.budget_status),
      task.budget_reason,
      task.currency,
      task.foreign_value,
      task.exchange_rate,
      task.invoice_value,
      task.invoice_tax,
      task.observations
    ]
  end

  sheet.column_widths 10, 20, 30, 20, 20, 20, 40, 20, 25, 25, 18, 20, 40, 10, 18, 15, 20, 20, 40
end
